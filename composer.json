{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "anishopmobile/ani-doctor",
    "type": "project",
    "description": "Single physician appointment system - P1 identity foundation",
    "license": "proprietary",
    "require": {"php": "^8.4", "ext-intl": "*", "laravel/framework": "^13.0"},
    "require-dev": {"fakerphp/faker": "^1.23", "laravel/pint": "^1.27", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.6", "phpunit/phpunit": "^12.5.12"},
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {
        "test": ["@php artisan config:clear", "@php artisan test --without-tty"],
        "lint": "@php vendor/bin/pint --test",
        "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]
    },
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true, "platform": {"php": "8.4.0"}, "allow-plugins": {}},
    "minimum-stability": "stable",
    "prefer-stable": true
}
